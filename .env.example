# Copy to .env.local (gitignored) or set in the Vercel project.
# Never commit a file containing real values -- see docs/RUNTIME_ARCHITECTURE_NOTES.md §10.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>
MONGODB_DB=<database>

# Admin API authorization.
# ADMIN_AUTH_ENABLED ships unset. Do NOT set it to "true" until the browser
# clients authenticate via session cookie -- enabling it early makes /admin
# unusable with no recovery path. Check GET /api/health -> adminAuth for the
# current rollout state.
ADMIN_API_KEY=<32-byte CSPRNG value, server-only, never NEXT_PUBLIC_>
ADMIN_AUTH_ENABLED=

# Signs the admin session cookie. MUST be a different value from ADMIN_API_KEY:
# rotating this invalidates every live session without changing the credential
# the automation path uses. That is the emergency revoke.
ADMIN_SESSION_SECRET=<32-byte CSPRNG value>

# Edge hardening (all optional; defaults in lib/rate-limit.ts and
# lib/security-headers.ts).
CSP_REPORT_ONLY=            # "false" to enforce the policy
HSTS_MAX_AGE=               # default 86400; raise only when no HTTP-only dependency remains
HSTS_PRELOAD=               # "true" only after the long max-age has been live
RATE_LIMIT_SIGNIN_MAX=
RATE_LIMIT_SIGNIN_WINDOW_MS=
RATE_LIMIT_WRITE_MAX=
RATE_LIMIT_WRITE_WINDOW_MS=

# Agent runtime credentials live in .env.<tenantId>, not here.
