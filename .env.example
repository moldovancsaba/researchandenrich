# Copy to .env.local (gitignored) or set in the Vercel project.
# Never commit a file containing real values -- see docs/RUNTIME_ARCHITECTURE_NOTES.md §10.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>
MONGODB_DB=<database>

# Admin API authorization.
# ADMIN_AUTH_ENABLED ships unset. Do NOT set it to "true" until the browser
# clients authenticate via session cookie -- enabling it early makes /admin
# unusable with no recovery path. Check GET /api/health -> adminAuth for the
# current rollout state.
ADMIN_API_KEY=<32-byte CSPRNG value, server-only, never NEXT_PUBLIC_>
ADMIN_AUTH_ENABLED=

# Agent runtime credentials live in .env.<tenantId>, not here.
