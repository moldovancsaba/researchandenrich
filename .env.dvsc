# DVSC ContentCreator credentials
# Placeholder values -- not yet committed with real secrets. DVSC has no
# separate database or API key of its own: it shares the same SLG_API_KEY
# and the same MongoDB Atlas cluster as cogmap/seyu (confirmed by host
# comparison across .env.cogmap/.env.seyu/salesleadgenerator's own
# MONGODB_URI -- all resolve to the same cluster; see
# docs/RUNTIME_ARCHITECTURE_NOTES.md §6). To activate: copy the real
# SLG_API_KEY value from .env.cogmap or .env.seyu verbatim, and either
# reuse one of their real Mongo connection strings or request a
# dvsc-scoped one from whoever administers the cluster. See README.md's
# "New Agent Onboarding" section for the full setup sequence.
# Set file permissions to 600 after filling in, matching .env.cogmap/.env.seyu.
export SLG_API_KEY=REPLACE_WITH_REAL_SLG_API_KEY
export DVSC_MONGODB_URI=REPLACE_WITH_REAL_DVSC_MONGODB_URI
